# name: test/sql/web_http.test
# description: Test erpl_odata extension HTTP client functionality
# group: [erpl_odata_http]

# Require statement will ensure this test is run with this extension loaded
require erpl_odata

statement ok
SET autoinstall_known_extensions=1;

statement ok
SET autoload_known_extensions=1;

statement ok
SET erpl_trace_enabled=false;

# ============================================================================
# SECTION 1: Basic HTTP Operations
# ============================================================================

# Test HTTP GET with a reliable test service
# Note: httpbin.org can return 502 if temporarily unavailable
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_get('https://httpbin.org/status/200') LIMIT 1;
----
200

# Test HTTP HEAD
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_head('https://httpbin.org/status/200') LIMIT 1;
----
200

# Test HTTP POST with JSON
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_post('https://httpbin.org/anything', '{"test": "data"}', 'application/json') LIMIT 1;
----
200

# Test HTTP PUT
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_put('https://httpbin.org/anything', '{"update": "value"}', 'application/json') LIMIT 1;
----
200

# Test HTTP PATCH
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_patch('https://httpbin.org/patch', '{"patch": "value"}', 'application/json') LIMIT 1;
----
200

# Test HTTP DELETE
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_delete('https://httpbin.org/status/200', '{}'::JSON) LIMIT 1;
----
200

# ============================================================================
# SECTION 2: HTTP Response Structure
# ============================================================================

# Test that HTTP functions return consistent structure
# Use split_part to extract base MIME type (ignore charset which varies)
query IIII
SELECT method, CASE WHEN status IN (200, 502) THEN 200 ELSE status END as status, url, split_part(content_type, ';', 1)
FROM http_get('https://httpbin.org/status/200') LIMIT 1;
----
GET
200
https://httpbin.org/status/200
text/html

# Test response headers
query I
SELECT COUNT(*) FROM http_get('https://httpbin.org/response-headers?X-Test=value') LIMIT 1;
----
1

# ============================================================================
# SECTION 3: Content Types and Request Bodies
# ============================================================================

# Test POST with text content
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_post('https://httpbin.org/anything', 'Hello World', 'text/plain') LIMIT 1;
----
200

# Test POST with form data
query I
SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
FROM http_post('https://httpbin.org/anything', 'key1=value1&key2=value2', 'application/x-www-form-urlencoded') LIMIT 1;
----
200

# ============================================================================
# SECTION 4: Performance and Edge Cases
# ============================================================================

# Timeout, url_encode and body-integrity coverage now lives in
# test/cpp/test_http_timeout_and_encoding.cpp.
#
# What stood here could not fail. The assertions were
#
#     SELECT CASE WHEN status IN (200, 502) THEN 200 ELSE status END
#     FROM http_get('https://httpbin.org/delay/2') LIMIT 1;  ----> 200
#
# and /delay/2 answers 200 whatever the client does with timeouts, while normalising 502 to
# 200 passed a failed request as well. Deleting the timeout assignment in web_functions.cpp
# left the timeout cases green.
#
# A client timeout can only be tested against a server slower than the timeout, which needs a
# controllable delay - so these moved to the local ODataTestServer, which now supports one.
# The C++ cases assert what a status cannot show: that a short timeout FAILS while a long one
# succeeds, that url_encode is visible in the recorded request target, and that a body
# arrives at its full length. See GitHub #246.

# ============================================================================
# SECTION 5: HTTP Configuration
# ============================================================================

# Test HTTP configuration (skip due to missing settings)
statement ok
SELECT 'Testing HTTP configuration...' as status;

# Test retry configuration (skip due to missing settings)
statement ok
SELECT 'Testing HTTP retry configuration...' as status;

# Reset to defaults
statement ok
SELECT 'HTTP configuration tests completed...' as status;

# ============================================================================
# SECTION 6: Authentication Precedence Testing
# ============================================================================

# Test 1: Create a test secret for authentication fallback
statement ok
CREATE SECRET test_auth_secret (
    TYPE http_basic,
    USERNAME 'secret_user',
    PASSWORD 'secret_pass',
    SCOPE 'https://httpbin.org/'
);

# The authentication cases that used to live here are now in
# test/cpp/test_http_auth_headers.cpp.
#
# They began as assertions against https://httpbin.org/status/200 - an endpoint that answers
# 200 whatever you send - checking only the status, so deleting AuthHeadersFromParams() in
# web_functions.cpp left every one of them green. Rewriting them against httpbin's echo
# endpoints fixed that and cost five live requests per run; one of them then failed on the
# musl CI leg while its siblings passed, which is the flakiness the original
# `CASE WHEN status IN (200, 502)` wrapper had been hiding at the price of also passing when
# a request failed outright.
#
# The local ODataTestServer records the request, so the Authorization header can be asserted
# directly. That keeps what the rewrite gained - these fail when auth breaks - without
# depending on a third party being up. See GitHub #243.

# Test 8: Clean up test secret
statement ok
DROP SECRET test_auth_secret;
