# name: test/sql/graph_teams_integration.test
# description: Integration tests for Microsoft Graph Teams
# group: [erpl_odata]
# note: Teams functions require delegated authentication
#       Run ./scripts/acquire_graph_token.sh to get delegated tokens

require erpl_odata

require-env ERPL_MS_TENANT_ID

require-env ERPL_MS_CLIENT_ID

require-env ERPL_MS_DELEGATED_ACCESS_TOKEN

require-env ERPL_MS_DELEGATED_EXPIRES_AT

require-env ERPL_MS_OUTLOOK_USER_ID

# Create secret with delegated (user) credentials
statement ok
CREATE SECRET ms_graph_teams_test (
    TYPE microsoft_graph,
    PROVIDER config,
    tenant_id '${ERPL_MS_TENANT_ID}',
    client_id '${ERPL_MS_CLIENT_ID}',
    access_token '${ERPL_MS_DELEGATED_ACCESS_TOKEN}',
    expires_at '${ERPL_MS_DELEGATED_EXPIRES_AT}'
);

# Test: graph_my_teams returns data without explicit user (delegated /me/ path)
query I
SELECT COUNT(*) >= 0 FROM graph_my_teams();
----
true

# Test: graph_my_teams accepts user param (same result when GUID matches token owner)
query I
SELECT COUNT(*) >= 0 FROM graph_my_teams(user := '${ERPL_MS_OUTLOOK_USER_ID}', secret := 'ms_graph_teams_test');
----
true

# Test: graph_my_teams has expected columns
query I
SELECT COUNT(*) FROM (
    SELECT column_name FROM (DESCRIBE SELECT * FROM graph_my_teams())
    WHERE column_name IN ('id', 'display_name', 'description', 'visibility', 'web_url', 'is_archived')
);
----
6

# Test: graph_teams_channels function exists
query I
SELECT COUNT(*) FROM duckdb_functions() WHERE function_name = 'graph_teams_channels';
----
1

# Test: graph_teams_members function exists
query I
SELECT COUNT(*) FROM duckdb_functions() WHERE function_name = 'graph_teams_members';
----
1

# Test: graph_channel_messages function exists
query I
SELECT COUNT(*) FROM duckdb_functions() WHERE function_name = 'graph_channel_messages';
----
1

# Cleanup
statement ok
DROP SECRET ms_graph_teams_test;
