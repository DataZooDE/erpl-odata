# name: test/sql/tls_settings.test
# description: TLS server certificate verification settings (GitHub #63)
# group: [erpl_odata]

require erpl_odata

# =============================================================================
# Both TLS settings are registered
# =============================================================================

query I
SELECT count(*) FROM duckdb_settings()
WHERE name IN ('erpl_ca_cert_file', 'erpl_unsafe_disable_server_cert_verification');
----
2

# =============================================================================
# Secure by default: neither knob is engaged out of the box
# =============================================================================

query I
SELECT current_setting('erpl_ca_cert_file');
----
(empty)

query I
SELECT current_setting('erpl_unsafe_disable_server_cert_verification');
----
(empty)

# =============================================================================
# The opt-out is hard to trip by accident: only the exact token is accepted
# =============================================================================

statement error
SET erpl_unsafe_disable_server_cert_verification = 'true';
----
I_UNDERSTAND_THIS_IS_INSECURE

statement error
SET erpl_unsafe_disable_server_cert_verification = '1';
----
I_UNDERSTAND_THIS_IS_INSECURE

statement error
SET erpl_unsafe_disable_server_cert_verification = 'yes';
----
I_UNDERSTAND_THIS_IS_INSECURE

statement ok
SET erpl_unsafe_disable_server_cert_verification = 'I_UNDERSTAND_THIS_IS_INSECURE';

# Clearing the setting restores verification
statement ok
SET erpl_unsafe_disable_server_cert_verification = '';

# =============================================================================
# A CA bundle path must actually exist
# =============================================================================

statement error
SET erpl_ca_cert_file = '/definitely/not/a/real/ca-bundle.pem';
----
no such file

statement ok
SET erpl_ca_cert_file = '';

# =============================================================================
# erpl_unsafe_allow_custom_service_urls (GitHub #199)
#
# Business Central and Datasphere mint their OAuth token for a FIXED audience, so pointing
# those readers at another https host would hand it a credential issued for a different
# one. Loopback never needs this setting. Dataverse is unaffected: its scope is derived
# from environment_url, so a custom host is the normal product.
#
# Same shape as the TLS opt-out above: only the exact token is accepted, because a flag
# that is easy to trip by accident is not a gate.
# =============================================================================

statement ok
SET erpl_unsafe_allow_custom_service_urls = '';

statement error
SET erpl_unsafe_allow_custom_service_urls = 'true';
----
I_UNDERSTAND_THIS_SENDS_TOKENS_ELSEWHERE

statement error
SET erpl_unsafe_allow_custom_service_urls = '1';
----
I_UNDERSTAND_THIS_SENDS_TOKENS_ELSEWHERE

statement error
SET erpl_unsafe_allow_custom_service_urls = 'yes';
----
I_UNDERSTAND_THIS_SENDS_TOKENS_ELSEWHERE

# The error has to say WHY, not just refuse - a caller who hits this needs to know the
# token was minted for a different audience.
statement error
SET erpl_unsafe_allow_custom_service_urls = 'please';
----
audience

statement ok
SET erpl_unsafe_allow_custom_service_urls = 'I_UNDERSTAND_THIS_SENDS_TOKENS_ELSEWHERE';

# ...and it can be turned back off.
statement ok
SET erpl_unsafe_allow_custom_service_urls = '';
